# Copy to .env and adjust: cp .env.example .env
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=lamplighter
POSTGRES_PASSWORD=lamplighter
POSTGRES_DB=lamplighter
POSTGRES_TEST_DB=lamplighter_test

GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Ethereal SMTP account; EMAIL is both the username and sender address.
EMAIL=replace-with-your-ethereal-email
EMAIL_PASSWORD=replace-with-your-ethereal-password

# 32-byte hex key for encrypted monitor headers. Keep the same key across restarts.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SECRETS_KEY=
